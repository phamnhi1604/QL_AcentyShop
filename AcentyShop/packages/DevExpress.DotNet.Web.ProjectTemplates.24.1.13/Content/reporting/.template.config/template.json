{
  "$schema": "http://json.schemastore.org/template",
  "author": "Developer Express Inc. ",
  "classifications": [ "Web", "MVC", "Reporting", "C#" ],
  "identity": "devexpress.reporting.netcore.template",
  "name": "DevExpress ASP.NET Core Reporting Project",
  "shortName": "dx.reporting",
  "description": "A template for creating an ASP.NET Core application with the DevExpress Web Document Viewer and/or End-User Report Designer. To start a project, specify the DevExpress NuGet Feed URL as a required feed parameter. Refer to https://nuget.devexpress.com/#feed-url and login to your account to obtain your Feed URL.",
  "tags": {
    "language": "C#"
  },
  "sourceName": "DevExpressProjectTemplate",
  "preferNameDirectory": true,
  "symbols": {
    "nuget-feed": {
      "type": "parameter",
      "defaultValue": "",
      "replaces": "DX_NUGET_FEED_URL",
      "description": "Refer to https://nuget.devexpress.com/#feed-url and login to your account to obtain your Feed URL."
    },
    "add-designer": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "true",
      "description": "Whether to add a web page that contains the Report Designer."
    },
    "add-viewer": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "true",
      "description": "Whether to add a web page that contains the Document Viewer."
    },
    "add-data-source": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "true",
      "description": "Whether to register a sample connection string to create SQL Data Sources in the Report and Data Source Wizards. This connection string is also used to register a predefined data source in the Report Designer."
    },
    "AddJsonDataSourceService": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "false",
      "description": "Whether to register a sample data connection storage to create JSON Data Sources in the Report and Data Source Wizards. "
    },
    "AddObjectDataSourceProvider": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "false",
      "description": "Whether to register a sample data object to create Object Data Sources in the Report and Data Source Wizards."
    },
    "EnableClientRichEdit": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "false",
      "description": "Whether to enable an advanced in-line editor for the Report Designer's RichText control."
    },
    "Dockerfile": {
      "type": "parameter",
      "dataType": "choice",
      "choices": [
        {
          "choice": "None",
          "description": "Skip docker support."
        },
        {
          "choice": "Debian",
          "description": "Debian-based Dockerfile."
        },
        {
          "choice": "Alpine",
          "description": "Alpine-based Dockerfile"
        },
        {
          "choice": "Ubuntu",
          "description": "Ubuntu-based Dockerfile."
        },
        {
          "choice": "openSUSE",
          "description": "openSUSE-based Dockerfile."
        },
        {
          "choice": "Amazon Linux",
          "description": "Amazon Linux based Dockerfile."
        }
      ],
      "defaultValue": "None",
      "description": "Create a Dockerfile based on the selected OS. Select None to create Reporting app without Docker support."
    },
    "framework": {
      "type": "parameter",
      "dataType": "choice",
      "choices": [
        {
          "choice": "net6.0",
          "description": "Target .Net6.0"
        },
        {
          "choice": "net7.0",
          "description": "Target .Net7.0"
        },
        {
          "choice": "net8.0",
          "description": "Target .Net8.0"
        }
      ],
      "defaultValue": "net6.0",
      "description": "The target framework for the project.",
      "replaces": "net6.0"
    },
    "DocumentStorage": {
      "type": "parameter",
      "dataType": "choice",
      "choices": [
        {
          "choice": "InMemoryStorage",
          "description": "Default cache that stores objects directly in memory without serialization, optimized for frequent operations."
        },
        {
          "choice": "XPOStorage",
          "description": "Implements database cache based on the XPO library, designed for multi-instance applications to prevent cache data loss."
        },
        {
          "choice": "FileStorage",
          "description": "Configures the reporting engine to store documents generated by reports on disk instead of in memory."
        },
        {
          "choice": "DistributedCache",
          "description": "Enables cache as external service that uses ASP.NET Core distributed caching mechanism and can be shared by multiple application servers."
        },
        {
          "choice": "AzureStorage",
          "description": "Configures the application to use Azure caching services."
        }
      ],
      "defaultValue": "InMemoryStorage",
      "description": "Select the storage type to cache documents that the report creates."
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(nuget-feed == '')",
          "exclude": [ "NuGet.config" ]
        },
        {
          "condition": "(!add-designer)",
          "exclude": [ "Views/Home/Designer.cshtml" ]
        },
        {
          "condition": "(!add-viewer)",
          "exclude": [ "Views/Home/Viewer.cshtml" ]
        },
        {
          "condition": "(!add-data-source)",
          "exclude": [ "Data/**", "Data" ]
        },
        {
          "condition": "(!AddJsonDataSourceService)",
          "exclude": [ "Code/SessionExtensions.cs", "Data/nwind.json", "Services/CustomJsonDataConnectionProviderFactory.cs", "Services/CustomDataSourceWizardJsonDataConnectionStorage.cs" ]
        },
        {
          "condition": "(!AddObjectDataSourceProvider)",
          "exclude": [ "ObjectDataSource/EmployeesDataSource.cs", "Services/ObjectDataSourceWizardCustomTypeProvider.cs" ]
        },
        {
          "condition": "(Dockerfile == 'None')",
          "exclude": [ "Debian.dockerfile", "Alpine.dockerfile", "Ubuntu.dockerfile", "openSUSE.dockerfile", "AmazonLinux.dockerfile", ".dockerignore", "secrets.dev.yaml", "readme.md" ],
          "rename": { "Debian.dockerfile": "Dockerfile" }
        },
        {
          "condition": "(Dockerfile == 'Debian')",
          "exclude": [ "Alpine.dockerfile", "Ubuntu.dockerfile", "openSUSE.dockerfile", "AmazonLinux.dockerfile" ],
          "rename": { "Debian.dockerfile": "Dockerfile" }
        },
        {
          "condition": "(Dockerfile == 'Alpine')",
          "exclude": [ "Debian.dockerfile", "Ubuntu.dockerfile", "openSUSE.dockerfile", "AmazonLinux.dockerfile" ],
          "rename": { "Alpine.dockerfile": "Dockerfile" }
        },
        {
          "condition": "(Dockerfile == 'Ubuntu')",
          "exclude": [ "Alpine.dockerfile", "Debian.dockerfile", "openSUSE.dockerfile", "AmazonLinux.dockerfile" ],
          "rename": { "Ubuntu.dockerfile": "Dockerfile" }
        },
        {
          "condition": "(Dockerfile == 'openSUSE')",
          "exclude": [ "Alpine.dockerfile", "Ubuntu.dockerfile", "Debian.dockerfile", "AmazonLinux.dockerfile" ],
          "rename": { "openSUSE.dockerfile": "Dockerfile" }
        },
        {
          "condition": "(Dockerfile == 'Amazon Linux')",
          "exclude": [ "Alpine.dockerfile", "Ubuntu.dockerfile", "openSUSE.dockerfile", "Debian.dockerfile" ],
          "rename": { "AmazonLinux.dockerfile": "Dockerfile" }
        },
        {
          "condition": "(DocumentStorage != 'XPOStorage')",
          "exclude": [ "Data/documentViewerStorage.db" ]
        }
      ]
    }
  ],
  "SpecialCustomOperations": {
    "**/*.dockerfile": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [ "#if" ],
            "else": [ "#else" ],
            "elseif": [ "#elseif" ],
            "endif": [ "#endif" ],
            "actionableIf": [ "##if" ],
            "actionableElse": [ "##else" ],
            "actionableElseif": [ "##elseif" ],
            "actions": [ "uncomment", "reduceComment" ],
            "trim": "true",
            "wholeLine": "true"
          }
        },
        {
          "type": "replacement",
          "configuration": {
            "original": "#",
            "replacement": "",
            "id": "uncomment"
          }
        },
        {
          "type": "replacement",
          "configuration": {
            "original": "##",
            "replacement": "#",
            "id": "reduceComment"
          }
        }
      ]
    }
  }
}