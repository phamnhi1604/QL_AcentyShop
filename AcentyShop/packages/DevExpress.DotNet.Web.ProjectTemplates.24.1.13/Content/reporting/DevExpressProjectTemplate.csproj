<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <!--#if(Dockerfile != 'None') -->
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>    
    <UserSecretsId>7bffbdbd-957d-40bc-92c8-236f2904aaee</UserSecretsId>
    <DockerfileFile>Dockerfile</DockerfileFile>
    <DockerfileContext>.</DockerfileContext>
    <DockerfileBuildArguments>--secret id=dxnuget,source=secrets.dev.yaml</DockerfileBuildArguments>
    <!--#endif-->
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Reports\**" />
    <Content Remove="Reports\**" />
    <EmbeddedResource Remove="Reports\**" />
    <None Remove="Reports\**" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Data\nwind.db" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Data\nwind.db">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!--#if(DocumentStorage == "XPOStorage")-->
    <Content Include="Data\documentViewerStorage.db">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!--#endif-->
  </ItemGroup>

  <Target Name="DebugEnsureNodeEnv" BeforeTargets="LibraryManagerRestore" Condition=" '$(Configuration)' == 'Debug' And !Exists('node_modules') ">
    <!-- Ensure Node.js is installed -->
    <Exec Command="node --version" ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="ErrorCode" />
    </Exec>
    <Error Condition="'$(ErrorCode)' != '0'" Text="Node.js is required to build and run this project. To continue, please install Node.js from https://nodejs.org/, and then restart your command prompt or IDE." />
    <Message Importance="high" Text="Restoring dependencies using 'npm'. This may take several minutes..." />
    <Exec Command="npm install" />
  </Target>
  
  <ItemGroup>
    <!--#if(Dockerfile != "None") -->
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.21.0" />
    <PackageReference Include="DevExpress.Drawing.Skia" Version="24.1-*" />
    <!--#endif-->
    <!--#if(DocumentStorage == "AzureStorage")-->
    <PackageReference Include="DevExpress.AspNetCore.Reporting.Azure" Version="24.1-*" />    
    <!--#endif-->
<!--#if(DocumentStorage == "DistributedCache")-->
<!--#if(framework == 'net6.0') -->
    <PackageReference Include="Microsoft.Extensions.Caching.SqlServer" Version="6.0.36" />
<!--#elseif(framework == 'net7.0') -->
    <PackageReference Include="Microsoft.Extensions.Caching.SqlServer" Version="7.0.20" />
<!--#elseif(framework == 'net8.0') -->
    <PackageReference Include="Microsoft.Extensions.Caching.SqlServer" Version="8.0.11" />
<!--#endif-->
<!--#endif-->
<!--#if(framework == 'net6.0') -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="6.0.36" />    
<!--#elseif(framework == 'net7.0') -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="7.0.20" />
<!--#elseif(framework == 'net8.0') -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
<!--#endif-->
    <PackageReference Include="System.Data.SQLite" Version="1.0.119" />
    <PackageReference Include="DevExpress.AspNetCore.Reporting" Version="24.1-*" />
    <PackageReference Include="BuildBundlerMinifier" Version="3.2.449" />
    <PackageReference Include="Microsoft.Web.LibraryManager.Build" Version="2.1.175" />
  </ItemGroup>
</Project>